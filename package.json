{
  "name": "@lakshmind5050/shreelakshmi-signup-form-component",
  "version": "1.0.3",
  "description": "A reusable React signup form component",
  "main": "dist/main.js",                       
  "module": "dist/index.esm.js",              
  "exports": {
    "import": "./dist/index.esm.js",            
    "require": "./dist/main.js"                
  },
  "files": [
  "dist/index.js",
  "dist/index.esm.js"
],
  "scripts": {
    "build": "webpack --mode production",
    "prepublishOnly": "npm run build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
  "keywords": ["react", "signup-form", "component"],
  "author": "ShreeLakshmi",
  "license": "ISC",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.7.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.1",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "babel": {
    "presets": ["@babel/preset-env", "@babel/preset-react"]
  },
  "publishConfig": {
    "access": "public"
  }
